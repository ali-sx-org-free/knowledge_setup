# 服務
PORT=8080
# 數據目錄：本地設定（含機密）與知識倉庫的工作副本
DATA_DIR=./data
# 管理員密碼（不設定時首次啟動自動生成，寫入 DATA_DIR/initial-admin-password.txt）
ADMIN_PASSWORD=
# 對外訪問地址（用於教程中的 API 根地址與 OpenRouter HTTP-Referer）
PUBLIC_BASE_URL=
# 服務端預設語言：zh-TW（預設）/ zh-CN / en。請求帶 ?lang= 或 Accept-Language 時以請求為準；也用於日誌
KNOWLEDGE_LANG=

# 知識持久化：使用你指定的 Git 倉庫（也可在後台「設定 › 知識倉庫」配置）
KNOWLEDGE_GIT_URL=
KNOWLEDGE_GIT_BRANCH=main
# https 倉庫的存取權杖（GitHub 細粒度 PAT：Contents 讀寫）
KNOWLEDGE_GIT_TOKEN=
# ssh 倉庫（git@github.com:org/repo.git）使用 SSH 部署金鑰：在後台「設定 › 知識倉庫」產生，
# 或執行 npm run ssh-key 產生並顯示公鑰，存放在 DATA_DIR/ssh/。也可以指定已有的私鑰檔（不能有密碼）：
KNOWLEDGE_GIT_SSH_KEY_FILE=
KNOWLEDGE_GIT_SUBDIR=knowledge

# 自然語言組織（OpenRouter）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 管道憑證：在管道 headers 中以 ${env:變數名} 引用，例如
# GATEWAY_TOKEN=
